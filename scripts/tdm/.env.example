# Copy this file to .env (same folder) and fill in. .env is gitignored - NEVER commit keys.

# --- where downloaded publisher content lives -------------------------------
# MUST be a LOCAL directory outside OneDrive and outside any git repo.
# (Elsevier terms: secure Canadian storage; UofT terms: do not publish/share.)
TDM_DATA_DIR=D:\tdm_private_data

# Used in the User-Agent so publishers can contact you (polite + required by some)
CONTACT_EMAIL=inorganic@accelerationconsortium.ai

# --- Springer Nature (dev.springernature.com) --------------------------------
SPRINGER_OA_KEY=
SPRINGER_META_KEY=

# --- Elsevier (dev.elsevier.com) ---------------------------------------------
ELSEVIER_KEY=

# --- Wiley (TDM token from Wiley Online Library account) ----------------------
WILEY_TDM_TOKEN=
