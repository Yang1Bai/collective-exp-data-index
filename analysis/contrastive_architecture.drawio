          <mxGeometry x="450" y="55" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="input_box" value="&lt;b&gt;Input Batch&lt;/b&gt;&lt;hr&gt;• Elemental composition (Fe, Co, Ir...)&lt;br&gt;• Stoichiometric fractions&lt;br&gt;• UV-vis spectra (patching)&lt;br&gt;• Synthesis conditions&lt;br&gt;• Reaction type" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16213e;strokeColor=#0f3460;fontColor=#e0e0e0;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="110" width="280" height="200" as="geometry" />
        </mxCell>
        <mxCell id="encoder_box" value="&lt;b&gt;Hierarchical Cross-Attention Encoder&lt;/b&gt;&lt;hr&gt;&lt;b&gt;CompositionSetEncoder&lt;/b&gt;&lt;br&gt;Element Embedding → TransformerEncoder (self-attn) → Query Pooling&lt;br&gt;&lt;br&gt;&lt;b&gt;CurveTransformer&lt;/b&gt;&lt;br&gt;Patching → FourierAxisEncoding → TransformerEncoder (self-attn)&lt;br&gt;&lt;br&gt;&lt;b&gt;ConditionTokenEncoder&lt;/b&gt;  |  &lt;b&gt;TaskTokenEncoder&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;CrossModalFusion&lt;/b&gt;&lt;br&gt;MultiheadAttention (queries attend over all modalities)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16213e;strokeColor=#e94560;fontColor=#e0e0e0;fontSize=13;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="460" y="110" width="680" height="200" as="geometry" />
        </mxCell>
        <mxCell id="latent_box" value="&lt;b&gt;Fused Latent z&lt;/b&gt;&lt;br&gt;&lt;font color='#a0a0c0'&gt;d_model = 64&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#533483;strokeColor=#e94560;fontColor=#ffffff;fontSize=16;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="520" y="360" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pred_head" value="&lt;b&gt;Prediction Head&lt;/b&gt;&lt;br&gt;MLP → log_variance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f3460;strokeColor=#533483;fontColor=#e0e0e0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="810" y="345" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="reg_loss" value="&lt;b&gt;Regression Loss&lt;/b&gt;&lt;br&gt;SmoothL1 + Rank + NLL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e94560;strokeColor=#e94560;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="810" y="410" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="contrast_proj" value="&lt;b&gt;ContrastiveProjection&lt;/b&gt;&lt;br&gt;Linear → BN → ReLU → Linear → L2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f3460;strokeColor=#533483;fontColor=#e0e0e0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="490" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="comp_sim" value="&lt;b&gt;Composition Cosine Similarity&lt;/b&gt;&lt;br&gt;118-dim periodic table vectors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f3460;strokeColor=#533483;fontColor=#e0e0e0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="570" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="pos_pairs" value="&lt;b&gt;Positive Pairs&lt;/b&gt;&lt;br&gt;sim &gt; 0.7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1b4332;strokeColor=#2d6a4f;fontColor=#e0e0e0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="650" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="neg_pairs" value="&lt;b&gt;Negative Pairs&lt;/b&gt;&lt;br&gt;sim &lt; 0.7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3c1518;strokeColor=#e94560;fontColor=#e0e0e0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="650" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ntxent" value="&lt;b&gt;NT‑Xent Loss&lt;/b&gt;&lt;br&gt;−log[exp(sim⁺/τ) / Σ exp(sim⁻/τ)]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e94560;strokeColor=#e94560;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="740" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="total_loss" value="&lt;b&gt;Total Loss&lt;/b&gt;&lt;br&gt;regression + 0.1 × contrastive" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e94560;strokeColor=#ffffff;fontColor=#ffffff;fontSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="520" y="830" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="result_box" value="&lt;b&gt;Results (40-epoch screening, SpecGen zero-shot transfer)&lt;/b&gt;&lt;hr&gt;Baseline median: 0.5837  |  &lt;b&gt;Contrastive median: 0.5995  (+0.0158)&lt;/b&gt;&lt;hr&gt;A: 0.5640 (+0.0225)  |  B: 0.6349 (+0.0090)  |  C: 0.2522 (−0.0457)  |  D: 0.7814 (+0.0196)&lt;br&gt;3/4 directions improved. C remains bottleneck (Fe‑doping out of source domain)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16213e;strokeColor=#0f3460;fontColor=#e0e0e0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="920" width="1100" height="120" as="geometry" />
        </mxCell>
        <mxCell id="key_box" value="&lt;b&gt;Key Insight&lt;/b&gt;&lt;hr&gt;Contrastive learning organizes the latent space by &lt;b&gt;chemistry&lt;/b&gt;, not by programme identity.&lt;br&gt;&lt;br&gt;&lt;b&gt;Before:&lt;/b&gt; samples cluster by lab/programme&lt;br&gt;&lt;b&gt;After:&lt;/b&gt; Fe₀.₄Co₀.₆ → Fe₀.₄₂Co₀.₅₈&lt;br&gt;(same chemistry, different lab)&lt;br&gt;&lt;br&gt;This cross-domain soft data augmentation bridges the source→target gap.&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Comparison (21 models)&lt;/b&gt;&lt;hr&gt;✅ &lt;b&gt;Contrastive: +0.0158&lt;/b&gt;&lt;br&gt;≈ k-NN Ensemble: +0.0118&lt;br&gt;≈ Baseline: 0.0000&lt;br&gt;❌ Adversarial: −0.008&lt;br&gt;❌ Pairwise: −0.605&lt;br&gt;❌ Diffusion: −0.186&lt;br&gt;❌ KL-Shampoo: −0.375&lt;hr&gt;&lt;b&gt;Why it works:&lt;/b&gt;&lt;br&gt;Composition similarity is &lt;b&gt;domain-invariant&lt;/b&gt; — it only depends on the periodic table, not on which lab measured the catalyst." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16213e;strokeColor=#533483;fontColor=#e0e0e0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1260" y="110" width="280" height="600" as="geometry" />
        </mxCell>
